generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  lastName            String
  phone               String?
  email               String               @unique
  password            String
  role                Role                 @default(CLIENT)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  classify            UserClassify?
  maternalLastName    String?
  activationTokens    ActivationToken[]
  Liquidation         Liquidation[]
  passwordResetTokens PasswordResetToken[]
  processRunsExecuted ProcessRun[]         @relation("ProcessRun_ExecutedBy")
  reservations        Reservation[]
  settingHistories    SettingHistory[]
  historyChanged      UserHistory[]        @relation("UserHistory_ChangedBy")
  history             UserHistory[]        @relation("UserHistory_User")
  userTags            UserTag[]

  contractsCreated   Contract[]              @relation("ContractCreatedBy")
  contractsUpdated   Contract[]              @relation("ContractUpdatedBy")
  customerContracts  Contract[]              @relation("UserContracts")
  commercialProducts UserCommercialProduct[] @relation("UserCommercialProducts")
  benefitBalances    UserBenefitBalance[]    @relation("UserBenefitBalances")
}

model UserHistory {
  id              Int      @id @default(autoincrement())
  userId          Int
  field           String
  oldValue        String?
  newValue        String?
  createdAt       DateTime @default(now())
  changedByUserId Int?
  changedBy       User?    @relation("UserHistory_ChangedBy", fields: [changedByUserId], references: [id])
  user            User     @relation("UserHistory_User", fields: [userId], references: [id])

  @@index([userId])
  @@index([changedByUserId])
}

model Space {
  id                        Int                 @id @default(autoincrement())
  name                      String
  type                      SpaceType
  capacity                  Int
  description               String?
  active                    Boolean             @default(true)
  hourlyRate                Decimal             @default(0.00) @db.Decimal(10, 2)
  imageUrl                  String?
  reservations              Reservation[]
  contractLines             ContractLine[]
  promotionRules            PromotionRule[]
  defaultCommercialProducts CommercialProduct[] @relation("CommercialProductDefaultSpace")
}

model Reservation {
  id                 Int               @id @default(autoincrement())
  date               DateTime
  startTime          DateTime
  endTime            DateTime
  userId             Int
  spaceId            Int
  status             ReservationStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  attendees          Int               @default(1)
  durationMinutes    Int               @default(0)
  hourlyRateSnapshot Decimal           @default(0.00) @db.Decimal(10, 2)
  notes              String?
  purpose            String?
  totalAmount        Decimal           @default(0.00) @db.Decimal(10, 2)
  recurrenceCount    Int?
  recurrenceEndDate  DateTime?
  recurrencePattern  String?
  seriesId           String?
  liquidationItem    LiquidationItem?
  space              Space             @relation(fields: [spaceId], references: [id])
  user               User              @relation(fields: [userId], references: [id])

  benefitConsumptions     BenefitConsumption[]
  pricingSnapshot         ReservationPricingSnapshot?
  userCommercialProductId Int?
  userCommercialProduct   UserCommercialProduct?      @relation(fields: [userCommercialProductId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([spaceId])
  @@index([status])
  @@index([date])
}

model Setting {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  value       String
  valueType   SettingValueType
  status      SettingStatus    @default(ACTIVE)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  history     SettingHistory[]
}

model SettingHistory {
  id              Int           @id @default(autoincrement())
  settingId       Int
  oldValue        String?
  newValue        String
  action          SettingAction
  changedByUserId Int?
  createdAt       DateTime      @default(now())
  changedBy       User?         @relation(fields: [changedByUserId], references: [id])
  setting         Setting       @relation(fields: [settingId], references: [id])

  @@index([settingId])
  @@index([changedByUserId])
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       UserTag[]
}

model UserTag {
  userId    Int
  tagId     Int
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model ActivationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ProcessRun {
  id               Int              @id @default(autoincrement())
  processName      String
  processCode      String
  executedByUserId Int
  executedAt       DateTime         @default(now())
  finishedAt       DateTime?
  status           ProcessRunStatus @default(RUNNING)
  inputFileName    String?
  inputFileType    String?
  totalRecords     Int              @default(0)
  successRecords   Int              @default(0)
  errorRecords     Int              @default(0)
  skippedRecords   Int              @default(0)
  resultSummary    String?
  errorSummary     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  executedByUser   User             @relation("ProcessRun_ExecutedBy", fields: [executedByUserId], references: [id])

  @@index([processCode])
  @@index([executedAt])
}

model OfficeClosure {
  id        Int      @id @default(autoincrement())
  /// *
  /// * Fecha (solo día) normalizada a 00:00.
  /// * Se usa para bloquear disponibilidad y reglas de recurrencia (MONTHLY/DAILY).
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  @@index([active])
  @@index([date])
}

model Liquidation {
  id        Int               @id @default(autoincrement())
  userId    Int
  total     Decimal           @db.Decimal(10, 2)
  status    LiquidationStatus @default(GENERATED)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id])
  items     LiquidationItem[]

  @@index([userId])
}

model LiquidationItem {
  id            Int         @id @default(autoincrement())
  liquidationId Int
  reservationId Int         @unique
  amount        Decimal     @db.Decimal(10, 2)
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

model CommercialProduct {
  id              Int                   @id @default(autoincrement())
  code            String                @unique
  name            String
  description     String?
  productType     CommercialProductType
  targetType      CommercialTargetType
  billingType     CommercialBillingType
  defaultUnitType CommercialUnitType
  taxMode         TaxMode               @default(EXCLUDED)
  isActive        Boolean               @default(true)
  validFrom       DateTime?
  validTo         DateTime?
  sortOrder       Int                   @default(0)
  metadataJson    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates                      CommercialRate[]
  benefits                   CommercialBenefit[]
  contractLines              ContractLine[]
  userProducts               UserCommercialProduct[]
  promotionRules             PromotionRule[]
  balances                   UserBenefitBalance[]
  ReservationPricingSnapshot ReservationPricingSnapshot[]
  requiresReservation        Boolean                      @default(false)
  defaultSpaceId             Int?
  defaultSpace               Space?                       @relation("CommercialProductDefaultSpace", fields: [defaultSpaceId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([productType])
  @@index([targetType])
}

model CommercialRate {
  id         Int                @id @default(autoincrement())
  productId  Int
  unitType   CommercialUnitType
  currency   String             @default("EUR")
  price      Decimal            @db.Decimal(10, 2)
  taxMode    TaxMode            @default(EXCLUDED)
  taxPercent Decimal?           @db.Decimal(5, 2)
  validFrom  DateTime
  validTo    DateTime?
  priority   Int                @default(0)
  isActive   Boolean            @default(true)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product                    CommercialProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  ReservationPricingSnapshot ReservationPricingSnapshot[]

  @@index([productId, isActive])
  @@index([validFrom, validTo])
}

model CommercialBenefit {
  id              Int                  @id @default(autoincrement())
  productId       Int
  benefitType     BenefitType
  targetType      CommercialTargetType
  unitType        CommercialUnitType
  creditAmount    Decimal              @db.Decimal(10, 2)
  resetEachPeriod Boolean              @default(false)
  resetFrequency  PaymentFrequency?
  rolloverAllowed Boolean              @default(false)
  isActive        Boolean              @default(true)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product CommercialProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
}

model Contract {
  id           Int            @id @default(autoincrement())
  code         String         @unique
  userId       Int
  status       ContractStatus @default(DRAFT)
  contractType ContractType   @default(OTHER)

  startDate DateTime
  endDate   DateTime?
  autoRenew Boolean   @default(false)

  paymentFrequency PaymentFrequency  @default(MONTHLY)
  paymentMethod    PaymentMethodType @default(TRANSFER)
  paymentTerms     String?
  agreedCurrency   String            @default("EUR")

  notes                 String?
  specialConditionsText String?

  signedAt    DateTime?
  cancelledAt DateTime?

  createdById Int?
  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("UserContracts", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ContractCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ContractUpdatedBy", fields: [updatedById], references: [id])

  lines                 ContractLine[]
  conditions            ContractCondition[]
  promotionRules        PromotionRule[]
  pricingSnapshots      ReservationPricingSnapshot[]
  UserCommercialProduct UserCommercialProduct[]

  @@index([userId, status])
  @@index([startDate, endDate])
}

model ContractLine {
  id          Int              @id @default(autoincrement())
  contractId  Int
  productId   Int?
  spaceId     Int?
  lineType    ContractLineType
  description String

  quantity Decimal            @default(1) @db.Decimal(10, 2)
  unitType CommercialUnitType

  listPrice   Decimal? @db.Decimal(10, 2)
  agreedPrice Decimal? @db.Decimal(10, 2)

  discountType  DiscountType @default(NONE)
  discountValue Decimal?     @db.Decimal(10, 2)

  billingType CommercialBillingType @default(RECURRING)

  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product  CommercialProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  space    Space?             @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([contractId, isActive])
  @@index([productId])
  @@index([spaceId])
}

model ContractCondition {
  id            Int                   @id @default(autoincrement())
  contractId    Int
  conditionType ContractConditionType
  title         String
  value         String?
  notes         String?
  priority      Int                   @default(0)
  isActive      Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, isActive])
}

model Promotion {
  id                Int                @id @default(autoincrement())
  code              String             @unique
  name              String
  description       String?
  status            PromotionStatus    @default(DRAFT)
  promotionType     PromotionType
  scopeType         PromotionScopeType
  startDate         DateTime
  endDate           DateTime?
  isCombinable      Boolean            @default(false)
  priority          Int                @default(0)
  usageLimitTotal   Int?
  usageLimitPerUser Int?
  metadataJson      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules            PromotionRule[]
  pricingSnapshots ReservationPricingSnapshot[]

  @@index([status])
  @@index([startDate, endDate])
}

model PromotionRule {
  id               Int  @id @default(autoincrement())
  promotionId      Int
  targetProductId  Int?
  targetSpaceId    Int?
  targetContractId Int?

  unitType        CommercialUnitType?
  minimumQuantity Decimal?            @db.Decimal(10, 2)

  discountPercent  Decimal? @db.Decimal(5, 2)
  discountAmount   Decimal? @db.Decimal(10, 2)
  specialUnitPrice Decimal? @db.Decimal(10, 2)

  bonusCreditAmount Decimal?            @db.Decimal(10, 2)
  bonusCreditUnit   CommercialUnitType?

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promotion      Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  targetProduct  CommercialProduct? @relation(fields: [targetProductId], references: [id], onDelete: SetNull)
  targetSpace    Space?             @relation(fields: [targetSpaceId], references: [id], onDelete: SetNull)
  targetContract Contract?          @relation(fields: [targetContractId], references: [id], onDelete: SetNull)

  @@index([promotionId, isActive])
  @@index([targetProductId])
  @@index([targetSpaceId])
  @@index([targetContractId])
}

model UserCommercialProduct {
  id         Int  @id @default(autoincrement())
  userId     Int
  productId  Int
  contractId Int?

  status BalanceStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  priceSnapshot Decimal? @db.Decimal(10, 2)
  currency      String   @default("EUR")
  taxMode       TaxMode?
  taxPercent    Decimal? @db.Decimal(5, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation("UserCommercialProducts", fields: [userId], references: [id], onDelete: Cascade)
  product  CommercialProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  contract Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)

  balances     UserBenefitBalance[]
  reservations Reservation[]

  @@index([userId, status])
  @@index([productId])
  @@index([contractId])
}

model UserBenefitBalance {
  id                      Int  @id @default(autoincrement())
  userId                  Int
  productId               Int
  userCommercialProductId Int?

  sourceType PricingSourceType
  targetType CommercialTargetType
  unitType   CommercialUnitType

  periodStart DateTime?
  periodEnd   DateTime?
  expiresAt   DateTime?

  grantedAmount   Decimal @db.Decimal(10, 2)
  consumedAmount  Decimal @default(0) @db.Decimal(10, 2)
  remainingAmount Decimal @db.Decimal(10, 2)

  status BalanceStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation("UserBenefitBalances", fields: [userId], references: [id], onDelete: Cascade)
  product               CommercialProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userCommercialProduct UserCommercialProduct? @relation(fields: [userCommercialProductId], references: [id], onDelete: SetNull)

  consumptions               BenefitConsumption[]
  ReservationPricingSnapshot ReservationPricingSnapshot[]

  @@index([userId, status])
  @@index([productId])
  @@index([expiresAt])
}

model BenefitConsumption {
  id             Int                @id @default(autoincrement())
  balanceId      Int
  reservationId  Int
  consumedAmount Decimal            @db.Decimal(10, 2)
  unitType       CommercialUnitType
  consumedAt     DateTime           @default(now())
  notes          String?

  balance     UserBenefitBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  reservation Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([balanceId])
  @@index([reservationId])
}

model ReservationPricingSnapshot {
  id            Int @id @default(autoincrement())
  reservationId Int @unique

  pricingSource    PricingSourceType
  contractId       Int?
  promotionId      Int?
  benefitBalanceId Int?
  appliedProductId Int?
  appliedRateId    Int?

  currency String @default("EUR")

  unitType CommercialUnitType?
  quantity Decimal?            @db.Decimal(10, 2)

  baseAmount     Decimal? @db.Decimal(10, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  benefitAmount  Decimal? @db.Decimal(10, 2)
  taxAmount      Decimal? @db.Decimal(10, 2)
  finalAmount    Decimal  @db.Decimal(10, 2)

  explanation  String?
  snapshotJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation    Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  contract       Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  promotion      Promotion?          @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  benefitBalance UserBenefitBalance? @relation(fields: [benefitBalanceId], references: [id], onDelete: SetNull)
  appliedProduct CommercialProduct?  @relation(fields: [appliedProductId], references: [id], onDelete: SetNull)
  appliedRate    CommercialRate?     @relation(fields: [appliedRateId], references: [id], onDelete: SetNull)

  @@index([pricingSource])
  @@index([contractId])
  @@index([promotionId])
}

enum LiquidationStatus {
  GENERATED
  PAID
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  PENDING
  CANCELLED
  REJECTED
  COMPLETED
  PENALIZED
  INVOICED
}

enum ProcessRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  ERROR
}

enum Role {
  ADMIN
  CLIENT
}

enum SpaceType {
  FIX_DESK
  FLEX_DESK
  MEETING_ROOM
  OFFICE
  SHARED_TABLE
}

enum SettingStatus {
  ACTIVE
  INACTIVE
}

enum SettingAction {
  CREATED
  UPDATED
  DEACTIVATED
}

enum SettingValueType {
  NUMBER
  STRING
  BOOLEAN
}

enum UserClassify {
  GOOD
  REGULAR
  BAD
}

enum CommercialProductType {
  PLAN
  BONUS
  RATE
}

enum CommercialTargetType {
  COWORKING
  MEETING_ROOM
  INSPIRATION_ROOM
  FULL_SPACE
  OTHER
}

enum CommercialBillingType {
  RECURRING
  PREPAID
  PAY_PER_USE
  INCLUDED
}

enum CommercialUnitType {
  HOUR
  DAY
  HALF_DAY
  FULL_DAY
  WEEK
  MONTH
  UNIT
  SESSION
}

enum TaxMode {
  INCLUDED
  EXCLUDED
  EXEMPT
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum ContractType {
  COWORKING
  ROOM
  MIXED
  CORPORATE
  OTHER
}

enum PaymentFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum PaymentMethodType {
  CASH
  TRANSFER
  CARD
  DIRECT_DEBIT
  OTHER
}

enum ContractLineType {
  PLAN
  BONUS
  SPACE_ACCESS
  DISCOUNT
  CUSTOM
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}

enum ContractConditionType {
  SCHEDULE
  CANCELLATION
  NOTICE
  ACCESS
  PRICE_EXCEPTION
  PROMO
  OTHER
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PromotionType {
  SPECIAL_PRICE
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  BONUS_CREDIT
}

enum PromotionScopeType {
  PRODUCT
  SPACE
  CONTRACT
  USER
  SEGMENT
  GLOBAL
}

enum BenefitType {
  INCLUDED_CREDIT
  BONUS_CREDIT
  DISCOUNT
  ACCESS_RIGHT
}

enum BalanceStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum PricingSourceType {
  CONTRACT
  BENEFIT
  PROMOTION
  STANDARD_RATE
  MANUAL
}
