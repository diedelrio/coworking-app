generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int           @id @default(autoincrement())
  name             String
  lastName         String
  phone            String?
  email            String        @unique
  password         String
  role             Role          @default(CLIENT)
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  classify         UserClassify?
  maternalLastName String?

  passwordResetTokens PasswordResetToken[]
  activationTokens    ActivationToken[]
  reservations        Reservation[]
  settingHistories    SettingHistory[]
  history             UserHistory[]        @relation("UserHistory_User")
  historyChanged      UserHistory[]        @relation("UserHistory_ChangedBy")
  Liquidation         Liquidation[]

  processRunsExecuted ProcessRun[] @relation("ProcessRun_ExecutedBy")
  userTags            UserTag[]

  // EP06-10 relations
  purchases     Purchase[]
  entitlements  UserEntitlement[]
  contracts     Contract[]
  invoices      Invoice[]
  conversations Conversation[]
  notifications Notification[]
}

model UserHistory {
  id              Int      @id @default(autoincrement())
  userId          Int
  field           String
  oldValue        String?
  newValue        String?
  changedByUserId Int?
  createdAt       DateTime @default(now())

  user      User  @relation("UserHistory_User", fields: [userId], references: [id])
  changedBy User? @relation("UserHistory_ChangedBy", fields: [changedByUserId], references: [id])

  @@index([userId])
  @@index([changedByUserId])
}

model Space {
  id          Int       @id @default(autoincrement())
  name        String
  type        SpaceType
  capacity    Int
  description String?
  active      Boolean   @default(true)

  hourlyRate Decimal @default(0.00) @db.Decimal(10, 2)
  imageUrl   String?

  reservations Reservation[]

  // EP06-10 relations
  priceItems PriceItem[]
  contracts  Contract[]
}

model Reservation {
  id        Int      @id @default(autoincrement())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  userId    Int
  spaceId   Int

  status            ReservationStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  attendees         Int               @default(1)
  // ✅ Recurrencia
  // Si seriesId es null => reserva no recurrente.
  seriesId          String?
  recurrencePattern String? // DAILY | WEEKLY | MONTHLY
  recurrenceEndDate DateTime?
  recurrenceCount   Int?

  // snapshot + cálculo
  hourlyRateSnapshot Decimal @default(0.00) @db.Decimal(10, 2)
  durationMinutes    Int     @default(0)
  totalAmount        Decimal @default(0.00) @db.Decimal(10, 2)

  // Bonos (consumo)
  entitlementId            Int?
  entitlementConsumedHours Int  @default(0)

  purpose String?
  notes   String?

  entitlement UserEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  space Space @relation(fields: [spaceId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  liquidationItem LiquidationItem?

  @@index([userId])
  @@index([spaceId])
  @@index([status])
  @@index([date])
}

model Setting {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  value       String
  valueType   SettingValueType
  status      SettingStatus    @default(ACTIVE)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  history SettingHistory[]
}

model SettingHistory {
  id              Int           @id @default(autoincrement())
  settingId       Int
  oldValue        String?
  newValue        String
  action          SettingAction
  changedByUserId Int?
  createdAt       DateTime      @default(now())

  changedBy User?   @relation(fields: [changedByUserId], references: [id])
  setting   Setting @relation(fields: [settingId], references: [id])

  @@index([settingId])
  @@index([changedByUserId])
}

model Tag {
  id               Int                  @id @default(autoincrement())
  name             String
  slug             String               @unique
  description      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  users            UserTag[]
  priceListTargets PriceListTargetTag[]
}

model UserTag {
  userId    Int
  tagId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model ActivationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ProcessRun {
  id               Int    @id @default(autoincrement())
  processName      String
  processCode      String
  executedByUserId Int
  executedByUser   User   @relation("ProcessRun_ExecutedBy", fields: [executedByUserId], references: [id])

  executedAt DateTime         @default(now())
  finishedAt DateTime?
  status     ProcessRunStatus @default(RUNNING)

  inputFileName String?
  inputFileType String?

  totalRecords   Int @default(0)
  successRecords Int @default(0)
  errorRecords   Int @default(0)
  skippedRecords Int @default(0)

  resultSummary String?
  errorSummary  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processCode])
  @@index([executedAt])
}

model OfficeClosure {
  id        Int      @id @default(autoincrement())
  /**
   * Fecha (solo día) normalizada a 00:00.
   * Se usa para bloquear disponibilidad y reglas de recurrencia (MONTHLY/DAILY).
   */
  date      DateTime
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([active])
  @@index([date])
}

model Liquidation {
  id        Int               @id @default(autoincrement())
  userId    Int
  total     Decimal           @db.Decimal(10, 2)
  status    LiquidationStatus @default(GENERATED)
  createdAt DateTime          @default(now())

  user  User              @relation(fields: [userId], references: [id])
  items LiquidationItem[]

  @@index([userId])
}

model LiquidationItem {
  id            Int     @id @default(autoincrement())
  liquidationId Int
  reservationId Int     @unique
  amount        Decimal @db.Decimal(10, 2)

  liquidation Liquidation @relation(fields: [liquidationId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model PriceList {
  id         Int                  @id @default(autoincrement())
  name       String
  priority   Int                  @default(0)
  active     Boolean              @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  items      PriceItem[]
  targetTags PriceListTargetTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([priority])
  @@index([validFrom])
  @@index([validTo])
}

model PriceItem {
  id          Int            @id @default(autoincrement())
  priceListId Int
  scope       PriceItemScope
  spaceType   SpaceType?
  spaceId     Int?
  unit        PriceUnit      @default(HOUR)
  price       Decimal        @db.Decimal(10, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  space     Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // evita duplicados por unidad y scope
  @@unique([priceListId, scope, spaceType, spaceId, unit])
  @@index([priceListId])
  @@index([scope])
  @@index([spaceType])
  @@index([spaceId])
  @@index([unit])
}

model PriceListTargetTag {
  priceListId Int
  tagId       Int

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([priceListId, tagId])
  @@index([tagId])
  @@index([priceListId])
}

model Purchase {
  id          Int            @id @default(autoincrement())
  userId      Int
  status      PurchaseStatus @default(PENDING)
  totalAmount Decimal        @db.Decimal(10, 2)
  createdAt   DateTime       @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlements UserEntitlement[]

  @@index([userId])
  @@index([status])
}

model UserEntitlement {
  id              Int             @id @default(autoincrement())
  userId          Int
  type            EntitlementType
  initialAmount   Int
  remainingAmount Int
  unit            PriceUnit       @default(HOUR)
  validFrom       DateTime?
  validTo         DateTime?
  purchaseId      Int?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Reservation Reservation[]

  @@index([userId])
  @@index([type])
  @@index([validTo])
}

model Contract {
  id            Int            @id @default(autoincrement())
  userId        Int
  spaceId       Int?
  startDate     DateTime
  endDate       DateTime?
  billingPeriod BillingPeriod
  amount        Decimal        @db.Decimal(10, 2)
  status        ContractStatus @default(ACTIVE)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  space    Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Invoice {
  id          Int           @id @default(autoincrement())
  userId      Int
  contractId  Int?
  periodStart DateTime
  periodEnd   DateTime
  amount      Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(DRAFT)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contractId, periodStart, periodEnd])
  @@index([userId])
  @@index([contractId])
  @@index([status])
}

model PublicContent {
  id        Int     @id @default(autoincrement())
  key       String  @unique
  content   String
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             Int               @id @default(autoincrement())
  conversationId Int
  senderRole     MessageSenderRole
  body           String
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  payload   String
  seenAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([seenAt])
}

enum PriceItemScope {
  GLOBAL
  SPACE_TYPE
  SPACE_ID
}

enum PriceUnit {
  HOUR
  HALF_DAY
  DAY
  MONTH
}

enum PurchaseStatus {
  PENDING
  PAID
  CANCELLED
}

enum EntitlementType {
  HOURS_PACK
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum ContractStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum MessageSenderRole {
  ADMIN
  CLIENT
}

enum NotificationType {
  NEW_MESSAGE
  RESERVATION_CREATED
}

enum LiquidationStatus {
  GENERATED
  PAID
  CANCELLED
}

enum ReservationStatus {
  PENDING
  ACTIVE
  CANCELLED
  REJECTED
  COMPLETED
  PENALIZED
  INVOICED
}

enum ProcessRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  ERROR
}

enum Role {
  ADMIN
  CLIENT
}

enum SpaceType {
  FIX_DESK
  FLEX_DESK
  MEETING_ROOM
  OFFICE
  SHARED_TABLE
}

enum SettingStatus {
  ACTIVE
  INACTIVE
}

enum SettingAction {
  CREATED
  UPDATED
  DEACTIVATED
}

enum SettingValueType {
  NUMBER
  STRING
  BOOLEAN
}

enum UserClassify {
  GOOD
  REGULAR
  BAD
}
