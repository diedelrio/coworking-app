generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  lastName            String
  phone               String?
  email               String               @unique
  password            String
  role                Role                 @default(CLIENT)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  classify            UserClassify?
  maternalLastName    String?
  activationTokens    ActivationToken[]
  Liquidation         Liquidation[]
  passwordResetTokens PasswordResetToken[]
  processRunsExecuted ProcessRun[]         @relation("ProcessRun_ExecutedBy")
  reservations        Reservation[]
  settingHistories    SettingHistory[]
  historyChanged      UserHistory[]        @relation("UserHistory_ChangedBy")
  history             UserHistory[]        @relation("UserHistory_User")
  userTags            UserTag[]
  consentAcceptances  UserConsentAcceptance[]
}


model UserHistory {
  id              Int      @id @default(autoincrement())
  userId          Int
  field           String
  oldValue        String?
  newValue        String?
  createdAt       DateTime @default(now())
  changedByUserId Int?
  changedBy       User?    @relation("UserHistory_ChangedBy", fields: [changedByUserId], references: [id])
  user            User     @relation("UserHistory_User", fields: [userId], references: [id])

  @@index([userId])
  @@index([changedByUserId])
}

model Space {
  id           Int           @id @default(autoincrement())
  name         String
  type         SpaceType
  capacity     Int
  description  String?
  active       Boolean       @default(true)
  hourlyRate   Decimal       @default(0.00) @db.Decimal(10, 2)
  imageUrl     String?
  reservations Reservation[]
}

model Reservation {
  id                 Int               @id @default(autoincrement())
  date               DateTime
  startTime          DateTime
  endTime            DateTime
  userId             Int
  spaceId            Int
  status             ReservationStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  attendees          Int               @default(1)
  durationMinutes    Int               @default(0)
  hourlyRateSnapshot Decimal           @default(0.00) @db.Decimal(10, 2)
  notes              String?
  purpose            String?
  totalAmount        Decimal           @default(0.00) @db.Decimal(10, 2)
  recurrenceCount    Int?
  recurrenceEndDate  DateTime?
  recurrencePattern  String?
  seriesId           String?
  liquidationItem    LiquidationItem?
  space              Space             @relation(fields: [spaceId], references: [id])
  user               User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([spaceId])
  @@index([status])
  @@index([date])
}

model Setting {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  value       String
  valueType   SettingValueType
  status      SettingStatus    @default(ACTIVE)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  history     SettingHistory[]
}

model SettingHistory {
  id              Int           @id @default(autoincrement())
  settingId       Int
  oldValue        String?
  newValue        String
  action          SettingAction
  changedByUserId Int?
  createdAt       DateTime      @default(now())
  changedBy       User?         @relation(fields: [changedByUserId], references: [id])
  setting         Setting       @relation(fields: [settingId], references: [id])

  @@index([settingId])
  @@index([changedByUserId])
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       UserTag[]
}

model UserTag {
  userId    Int
  tagId     Int
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model ActivationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ProcessRun {
  id               Int              @id @default(autoincrement())
  processName      String
  processCode      String
  executedByUserId Int
  executedAt       DateTime         @default(now())
  finishedAt       DateTime?
  status           ProcessRunStatus @default(RUNNING)
  inputFileName    String?
  inputFileType    String?
  totalRecords     Int              @default(0)
  successRecords   Int              @default(0)
  errorRecords     Int              @default(0)
  skippedRecords   Int              @default(0)
  resultSummary    String?
  errorSummary     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  executedByUser   User             @relation("ProcessRun_ExecutedBy", fields: [executedByUserId], references: [id])

  @@index([processCode])
  @@index([executedAt])
}

model OfficeClosure {
  id        Int      @id @default(autoincrement())
  /// *
  /// * Fecha (solo día) normalizada a 00:00.
  /// * Se usa para bloquear disponibilidad y reglas de recurrencia (MONTHLY/DAILY).
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  @@index([active])
  @@index([date])
}

model Liquidation {
  id        Int               @id @default(autoincrement())
  userId    Int
  total     Decimal           @db.Decimal(10, 2)
  status    LiquidationStatus @default(GENERATED)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id])
  items     LiquidationItem[]

  @@index([userId])
}

model LiquidationItem {
  id            Int         @id @default(autoincrement())
  liquidationId Int
  reservationId Int         @unique
  amount        Decimal     @db.Decimal(10, 2)
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

model ConsentDefinition {
  id                         Int                     @id @default(autoincrement())
  key                        String                  @unique
  title                      String
  type                       ConsentType
  version                    String
  description                String?
  active                     Boolean                 @default(true)
  required                   Boolean                 @default(false)
  requiresAcceptance         Boolean                 @default(true)
  showDocumentsToUser        Boolean                 @default(true)
  allowUserDownloadDocuments Boolean                 @default(true)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  documents                  ConsentDocument[]
  acceptances                UserConsentAcceptance[]

  @@index([type])
  @@index([active])
}

model ConsentDocument {
  id                  Int               @id @default(autoincrement())
  consentDefinitionId Int
  title               String
  fileName            String
  mimeType            String
  contentBase64       String            @db.Text
  active              Boolean           @default(true)
  downloadEnabled     Boolean           @default(true)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  consentDefinition   ConsentDefinition @relation(fields: [consentDefinitionId], references: [id], onDelete: Cascade)

  @@index([consentDefinitionId])
}

model UserConsentAcceptance {
  id                  Int               @id @default(autoincrement())
  userId              Int
  consentDefinitionId Int
  consentVersion      String
  accepted            Boolean           @default(true)
  acceptedAt          DateTime          @default(now())
  source              String?
  ipAddress           String?
  userAgent           String?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentDefinition   ConsentDefinition @relation(fields: [consentDefinitionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentDefinitionId])
  @@index([acceptedAt])
}

enum ConsentType {
  TERMS_AND_POLICIES
  COMMERCIAL_COMMUNICATIONS
  SOCIAL_COMMUNICATIONS
  OTHER
}

enum LiquidationStatus {
  GENERATED
  PAID
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  PENDING
  CANCELLED
  REJECTED
  COMPLETED
  PENALIZED
  INVOICED
}

enum ProcessRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  ERROR
}

enum Role {
  ADMIN
  CLIENT
}

enum SpaceType {
  FIX_DESK
  FLEX_DESK
  MEETING_ROOM
  OFFICE
  SHARED_TABLE
}

enum SettingStatus {
  ACTIVE
  INACTIVE
}

enum SettingAction {
  CREATED
  UPDATED
  DEACTIVATED
}

enum SettingValueType {
  NUMBER
  STRING
  BOOLEAN
}

enum UserClassify {
  GOOD
  REGULAR
  BAD
}
